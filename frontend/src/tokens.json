{
  "name": "LifeHub Vaporwave",
  "font": {
    "display": "VT323, 'Courier New', monospace",
    "body": "'Space Mono', ui-monospace, monospace",
    "jp": "'Noto Sans JP', sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=VT323&family=Space+Mono:wght@400;700&family=Noto+Sans+JP:wght@700&display=swap"
  },
  "color": {
    "ink": "#2b1250",
    "inkSoft": "#6b4b8f",
    "face": "#f4e9ff",
    "paper": "#ffffff",
    "gray": "#c0b4d8",
    "pink": "#ff71ce",
    "cyan": "#01cdfe",
    "mint": "#05ffa1",
    "purple": "#b967ff",
    "yellow": "#fffb96",
    "magentaText": "#b0177f",
    "greenText": "#0a7a52"
  },
  "semantic": {
    "approve": "mint",
    "decline": "pink",
    "neutralButton": "gray",
    "accountWork": "cyan",
    "accountPersonal": "yellow",
    "groupReply": "pink",
    "groupFyi": "gray",
    "groupNewsletter": "cyan",
    "groupReceipt": "yellow",
    "tagCleanup": "yellow",
    "tagOllama": "mint",
    "tagEmail": "cyan",
    "tagApprovals": "pink",
    "stampApproved": "greenText",
    "stampDeclined": "magentaText"
  },
  "bevel": {
    "raised": "2px solid; border-color: #ffffff #2b1250 #2b1250 #ffffff",
    "raisedSoft": "2px solid; border-color: #ffffff #6b4b8f #6b4b8f #ffffff",
    "sunken": "2px solid; border-color: #6b4b8f #ffffff #ffffff #6b4b8f"
  },
  "shadow": { "window": "6px 6px 0 #2b1250", "dialog": "8px 8px 0 #2b1250", "accentPink": "6px 6px 0 #ff71ce" },
  "radius": 0,
  "titleBarGradients": [
    "linear-gradient(90deg, #ff71ce, #b967ff)",
    "linear-gradient(90deg, #01cdfe, #b967ff)",
    "linear-gradient(90deg, #05ffa1, #01cdfe)",
    "linear-gradient(90deg, #ff71ce, #fffb96)",
    "linear-gradient(90deg, #b967ff, #ff71ce)"
  ],
  "sky": {
    "sunrise": { "until": "12:00", "background": "linear-gradient(180deg, #ff9ad5 0%, #c79bff 38%, #8fd3ff 100%)" },
    "daydream": { "until": "18:00", "background": "linear-gradient(180deg, #8fd3ff 0%, #c7f5ff 50%, #f4e9ff 100%)" },
    "midnight": { "until": "24:00", "background": "linear-gradient(180deg, #2b1250 0%, #6b2fa0 55%, #ff71ce 100%)" }
  },
  "hero": {
    "sun": "circle 250px, repeating-linear-gradient(180deg, #fffb96 0 18px, #ff71ce 18px 22px)",
    "floor": "repeating-conic-gradient(#2b1250 0% 25%, #f4e9ff 0% 50%) 0 0 / 60px 60px; perspective(300px) rotateX(55deg)",
    "titleShadow": "3px 0 #01cdfe, -3px 0 #ff71ce, 0 4px 0 #2b1250"
  },
  "motion": {
    "scanline": "6s linear infinite",
    "stamp": "0.4s steps(6), rotate -8deg, scale 2.2 → 1",
    "cursorBlink": "1s steps(1) infinite",
    "respectReducedMotion": true
  },
  "favicon": "favicon/favicon.svg"
}
